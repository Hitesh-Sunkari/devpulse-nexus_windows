# Optional token for an authenticated local Sourcegraph instance.
SG_TOKEN=

# Sourcegraph runs independently of this application. The Docker Desktop
# default reaches a Sourcegraph instance published on the host at port 80.
SOURCEGRAPH_URL=http://host.docker.internal

# Scope evidence retrieval to the repository synchronized in Sourcegraph.
SOURCEGRAPH_REPOSITORY=github.com/Hitesh-Sunkari/devpulse-nexus_windows
