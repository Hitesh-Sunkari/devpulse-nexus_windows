# Optional token for an authenticated local Sourcegraph instance.
SG_TOKEN=

# Sourcegraph runs independently of this application. The Docker Desktop
# default reaches a Sourcegraph instance published on the host at port 80.
SOURCEGRAPH_URL=http://host.docker.internal
SOURCEGRAPH_PUBLIC_URL=http://localhost

# Scope evidence retrieval to the repository synchronized in Sourcegraph.
SOURCEGRAPH_REPOSITORY=github.com/Hitesh-Sunkari/devpulse-nexus_windows

# Reserve several CPU cores for the local Ollama inference worker. Adjust for
# smaller machines if Sourcegraph or Docker Desktop needs more headroom.
OLLAMA_NUM_THREADS=8

# Fast mode is one complete direct answer per request; Thorough mode supplies
# explanation, evidence, and caveats for each request.
COMPARISON_FAST_NUM_PREDICT=56
COMPARISON_THOROUGH_NUM_PREDICT=192
